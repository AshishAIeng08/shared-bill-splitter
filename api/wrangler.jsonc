{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shared-bill-splitter-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-23",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shared-bill-splitter",
      "database_id": "804a78a1-7615-4fd1-a37d-c4e0c6019d5b",
      "migrations_dir": "migrations"
    }
  ]
}
